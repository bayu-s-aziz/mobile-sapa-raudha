{
  "_type": "Project",
  "_id": "Seq_Admin_Reset_Project",
  "name": "Sequence Diagram - Admin Reset Password",
  "ownedElements": [
    {"_type": "UMLModel", "_id": "Seq_Admin_Reset_Model", "_parent": {"$ref": "Seq_Admin_Reset_Project"}, "name": "Model",
      "ownedElements": [
        {"_type": "UMLCollaboration", "_id": "Seq_Admin_Reset_Collab", "_parent": {"$ref": "Seq_Admin_Reset_Model"}, "name": "Proses Reset Password",
          "ownedElements": [
            {"_type": "UMLInteraction", "_id": "Seq_Admin_Reset_Interaction", "_parent": {"$ref": "Seq_Admin_Reset_Collab"}, "name": "Reset Password Interaction",
              "ownedElements": [
                {"_type": "UMLSequenceDiagram", "_id": "Seq_Admin_Reset", "_parent": {"$ref": "Seq_Admin_Reset_Interaction"}, "name": "Reset Password Sequence Diagram", "ownedViews": [],
                  "documentation": "Participants: Admin (Web), Web Admin UI, Reset Password Service, Database, WhatsApp/SMS Gateway.\n\nList pending: UI minta daftar, Service SELECT password_reset_requests WHERE status='pending'.\nDetail: UI minta detail, Service SELECT by id.\nApprove: Service UPDATE status='completed', update password_hash di gurus/parents, kirim password baru via gateway, UI tampilkan sukses.\nReject: Service UPDATE status='rejected' dengan notes, UI tampilkan penolakan."
                }
              ]
            },
            {"_type": "UMLLifeline", "_id": "LL_Admin", "_parent": {"$ref": "Seq_Admin_Reset_Interaction"}, "name": "Admin (Web)"},
            {"_type": "UMLLifeline", "_id": "LL_Web", "_parent": {"$ref": "Seq_Admin_Reset_Interaction"}, "name": "Web Admin UI"},
            {"_type": "UMLLifeline", "_id": "LL_Svc", "_parent": {"$ref": "Seq_Admin_Reset_Interaction"}, "name": "Reset Password Service"},
            {"_type": "UMLLifeline", "_id": "LL_DB", "_parent": {"$ref": "Seq_Admin_Reset_Interaction"}, "name": "Database"},
            {"_type": "UMLLifeline", "_id": "LL_SMS", "_parent": {"$ref": "Seq_Admin_Reset_Interaction"}, "name": "WhatsApp/SMS Gateway"}
          ]
        }
      ]
    }
  ]
}
