{
	"_type": "Project",
	"_id": "ActivityDiagram_Admin_Login_Project",
	"name": "Activity Diagram - Admin Login",
	"ownedElements": [
		{
			"_type": "UMLModel",
			"_id": "ActivityDiagram_Admin_Login_Model",
			"_parent": {
				"$ref": "ActivityDiagram_Admin_Login_Project"
			},
			"name": "Admin Login Model",
			"ownedElements": [
				{
					"_type": "UMLActivityDiagram",
					"_id": "ActivityDiagram_Admin_Login",
					"_parent": {
						"$ref": "ActivityDiagram_Admin_Login_Model"
					},
					"name": "Activity Diagram - Admin Login",
					"ownedViews": [],
					"documentation": "Activity diagram untuk proses login admin pada aplikasi Sapa Raudha.\n\nDeskripsi:\n1. Admin membuka halaman web admin\n2. Admin memasukkan NIK dan password\n3. Sistem melakukan validasi kredensial\n4. Jika valid, admin masuk ke dashboard admin\n5. Jika tidak valid, sistem menampilkan pesan error dan admin dapat mencoba lagi"
				},
				{
					"_type": "UMLActivity",
					"_id": "Activity_AdminLogin",
					"_parent": {
						"$ref": "ActivityDiagram_Admin_Login_Model"
					},
					"name": "Login Admin",
					"ownedElements": [
						{
							"_type": "UMLActivityNode",
							"_id": "InitialNode_Start",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Start"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_BukaHalamanLogin",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Buka Halaman Web Admin"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_InputKredensial",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Input NIK dan Password"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_KlikLogin",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Klik Tombol Login"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_ValidasiKredensial",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Sistem Validasi Kredensial"
						},
						{
							"_type": "UMLDecisionNode",
							"_id": "Decision_KredensialValid",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Kredensial Valid?"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_TampilkanError",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Tampilkan Pesan Error"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_BuatSesiLogin",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Buat Sesi Login"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_RedirectDashboard",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "Redirect ke Dashboard Admin"
						},
						{
							"_type": "UMLActivityFinalNode",
							"_id": "FinalNode_End",
							"_parent": {
								"$ref": "Activity_AdminLogin"
							},
							"name": "End"
						}
					]
				}
			]
		}
	]
}
