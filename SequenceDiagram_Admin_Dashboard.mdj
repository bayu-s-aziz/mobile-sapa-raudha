      "ownedElements": [
        {"_type": "UMLCollaboration", "_id": "Seq_Admin_Dashboard_Collab", "_parent": {"$ref": "Seq_Admin_Dashboard_Model"}, "name": "Pantau Dashboard Admin",
          "ownedElements": [
            {"_type": "UMLInteraction", "_id": "Seq_Admin_Dashboard_Interaction", "_parent": {"$ref": "Seq_Admin_Dashboard_Collab"}, "name": "Dashboard Interaction",
              "ownedElements": [
                {"_type": "UMLSequenceDiagram", "_id": "Seq_Admin_Dashboard", "_parent": {"$ref": "Seq_Admin_Dashboard_Interaction"}, "name": "Dashboard Sequence Diagram", "ownedViews": [],
                  "documentation": "Participants: Admin (Web), Web Admin UI, Dashboard Service, Database.\n\nLoad: UI minta data dashboard (totals, presensi, pengumuman, pending). Service menjalankan beberapa query dan mengembalikan paket data untuk dirender.\nFilter: Admin set filter periode/kelas → UI minta data terfilter → Service query ulang → UI refresh.\nExport: Admin klik export → UI minta generate laporan → Service kumpulkan data → UI mengunduh file."
                }
              ]
            },
            {"_type": "UMLLifeline", "_id": "LL_Admin", "_parent": {"$ref": "Seq_Admin_Dashboard_Interaction"}, "name": "Admin (Web)"},
            {"_type": "UMLLifeline", "_id": "LL_Web", "_parent": {"$ref": "Seq_Admin_Dashboard_Interaction"}, "name": "Web Admin UI"},
            {"_type": "UMLLifeline", "_id": "LL_Svc", "_parent": {"$ref": "Seq_Admin_Dashboard_Interaction"}, "name": "Dashboard Service"},
            {"_type": "UMLLifeline", "_id": "LL_DB", "_parent": {"$ref": "Seq_Admin_Dashboard_Interaction"}, "name": "Database"}
          ]
        }
      ]
    }
  ]
