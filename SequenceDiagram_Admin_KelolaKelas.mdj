{
  "_type": "Project",
  "_id": "Seq_Admin_Kelas_Project",
  "name": "Sequence Diagram - Admin Kelola Kelas",
  "ownedElements": [
    {"_type": "UMLModel", "_id": "Seq_Admin_Kelas_Model", "_parent": {"$ref": "Seq_Admin_Kelas_Project"}, "name": "Model",
      "ownedElements": [
        {"_type": "UMLCollaboration", "_id": "Seq_Admin_Kelas_Collab", "_parent": {"$ref": "Seq_Admin_Kelas_Model"}, "name": "Kelola Data Kelas",
          "ownedElements": [
            {"_type": "UMLInteraction", "_id": "Seq_Admin_Kelas_Interaction", "_parent": {"$ref": "Seq_Admin_Kelas_Collab"}, "name": "Kelola Kelas Interaction",
              "ownedElements": [
                {"_type": "UMLSequenceDiagram", "_id": "Seq_Admin_Kelas", "_parent": {"$ref": "Seq_Admin_Kelas_Interaction"}, "name": "Kelola Kelas Sequence Diagram", "ownedViews": [],
                  "documentation": "Participants: Admin (Web), Web Admin UI, Kelas Service, Database.\n\nList: Admin buka menu, UI minta daftar, Service SELECT classes JOIN gurus (wali), DB kembalikan daftar.\nTambah: Admin isi data kelas, UI create, Service INSERT classes, DB OK, UI sukses & refresh.\nEdit: Admin ubah data/ganti wali, UI update, Service UPDATE classes, DB OK, UI sukses & refresh.\nHapus: Admin konfirmasi hapus, UI delete, Service DELETE classes (cek relasi students), DB OK/Gagal, UI tampilkan hasil."
                }
              ]
            },
            {"_type": "UMLLifeline", "_id": "LL_Admin", "_parent": {"$ref": "Seq_Admin_Kelas_Interaction"}, "name": "Admin (Web)"},
            {"_type": "UMLLifeline", "_id": "LL_Web", "_parent": {"$ref": "Seq_Admin_Kelas_Interaction"}, "name": "Web Admin UI"},
            {"_type": "UMLLifeline", "_id": "LL_Svc", "_parent": {"$ref": "Seq_Admin_Kelas_Interaction"}, "name": "Kelas Service"},
            {"_type": "UMLLifeline", "_id": "LL_DB", "_parent": {"$ref": "Seq_Admin_Kelas_Interaction"}, "name": "Database"}
          ]
        }
      ]
    }
  ]
}
