								"$ref": "Activity_AdminPantauDashboard"
							},
							"name": "Tampilkan Pengumuman Terbaru"
						},
						{
							"_type": "UMLActivityNode",
							"_id": "Action_TampilkanPermintaanPending",
							"_parent": {
								"$ref": "Activity_AdminPantauDashboard"
							},
							"name": "Tampilkan Permintaan Pending (Izin & Reset Password)"
						},
						{
